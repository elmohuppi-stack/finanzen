# Dependencies
/backend/vendor/
/frontend/node_modules/

# Build artifacts
/backend/public/build/
/frontend/dist/

# Environment
# Regel: öffentliche Build-Werte und Vorlagen gehören ins Repo, alles
# Personenbezogene oder Geheime ausschließlich auf den Server bzw. nach lokal.
/backend/.env
/backend/.env.*
/frontend/.env
/frontend/.env.*

# Vorlagen
!*.example

# Ausnahme mit Ansage: enthält nur die öffentliche API-URL und muss versioniert
# sein, weil der Docker-Build des Frontends sie braucht. Fehlt sie, baut ein
# frischer Checkout ein Frontend ohne API-Ziel — ohne dass der Build scheitert.
# Vertrauliches gehört nach frontend/.env.production.local: Vite lädt die Datei
# später und sie gewinnt damit für denselben Schlüssel.
!/frontend/.env.production

# Runtime / storage
/backend/storage/*.key
/backend/storage/logs/*
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
!/backend/storage/logs/.gitignore
!/backend/storage/framework/cache/.gitignore
!/backend/storage/framework/sessions/.gitignore
!/backend/storage/framework/views/.gitignore

# Local data imports/exports
/csv/*.csv
/csv/*.CSV
/docs/csv/*.csv
/docs/csv/*.CSV
/backend/storage/app/imports/*
/backend/storage/app/exports/*

# OS / editor
.DS_Store
.vscode/
.idea/
